      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh lock:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh unlock:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh precheck:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh status:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh stage2-begin:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh verdicts:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh stage3-replies:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh ranges:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh gate1:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh pg5:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh pg6:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh snapshot:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh post-review:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh reply:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh patch:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh comment:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh build:*)",
      "Bash(__PLUGIN_ROOT__/scripts/gh-get.sh:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh search:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "__REVIEW_WORKTREE_ADD__",
      "Bash(git worktree list:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Bash(git worktree add *..*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git diff *--no-index*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr close:*)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",
      "Bash(rtk:*)",
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/.env*)",
      "Edit(/__PLUGIN_ROOT__/scripts/**)",
      "Edit(/*.json)",
      "Edit(/*.md)",
      "Edit(/profiles/**)",
      "Edit(/runs/*/meta.json)"
    ]
