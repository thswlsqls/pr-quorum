{
  "disableAllHooks": true,
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/runs/**)",
      "Task",
      "Agent",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh sha:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh meta:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh config)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh learnings)",
