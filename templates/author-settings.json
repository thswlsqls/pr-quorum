{
  "disableAllHooks": true,
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(/runs/**)",
      "__AUTHOR_WORKTREES__",
      "Task",
      "Agent",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh sha:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh meta:*)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh config)",
      "Bash(__PLUGIN_ROOT__/scripts/pr-quorum.sh author-build:*)",
      "Bash(__PLUGIN_ROOT__/scripts/gh-get.sh:*)",
      "Bash(__PLUGIN_ROOT__/scripts/author-push.sh:*)",
      "Bash(__PLUGIN_ROOT__/scripts/author-reply.sh:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "__AUTHOR_WORKTREE_ADD__",
      "Bash(git worktree list:*)",
      "Bash(git checkout:*)",
      "Bash(cd:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch origin:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(git worktree add *..*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(git diff *--no-index*)",
      "Bash(git push:*)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git branch:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config:*)",
      "Bash(gh pr edit --base*)",
      "Bash(gh pr edit * --base*)",
      "Bash(gh pr edit -B*)",
      "Bash(gh pr edit * -B*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr close:*)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",
      "Bash(rtk:*)",
      "Read(~/.config/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/**)",
      "Read(~/.kube/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.envrc)",
      "Edit(/__PLUGIN_ROOT__/scripts/**)",
      "Edit(/*.json)",
      "Edit(/*.md)",
      "Edit(/profiles/**)",
      "Edit(/runs/*/learning-candidates.md)",
      "Edit(/runs/*/meta.json)"
    ]
  }
}
